# Local Postgres (Homebrew default: current OS user, no password)
DATABASE_URL=postgres://localhost:5432/crossover_dev

# Wikidata requires a descriptive User-Agent with contact info (policy).
WIKIDATA_USER_AGENT=CrossoverGame/0.1 (https://github.com/yourname/crossover; info@crossoverfootball.com)

# Fuzzy name-match thresholds for verification (pg_trgm word_similarity, 0..1).
# MATCH = low net for candidates + typo auto-correct floor (kept low so phonetic
# misspellings still match). EXACT = above this the guess is treated as a
# specific player name and judged strictly (stops "Ronaldinho"→"Ronaldo").
VERIFY_MATCH_THRESHOLD=0.3
VERIFY_EXACT_THRESHOLD=0.85

# ---- Production guardrails ----
# Set MAINTENANCE_MODE=1 to stop clients from starting new sessions gracefully.
MAINTENANCE_MODE=0
MIN_IOS_BUILD=1
MIN_ANDROID_VERSION_CODE=1
STORE_VERSION_CHECK_ENABLED=1
IOS_APP_STORE_ID=6778542426
IOS_BUNDLE_ID=com.crossover.football
APP_STORE_COUNTRY=tr
# Optional App Store Connect API key for exact live iOS buildNumber.
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_PRIVATE_KEY=
ANDROID_PACKAGE_NAME=com.crossover.football
PLAY_STORE_COUNTRY=TR
PLAY_STORE_LANGUAGE=en
PLAY_STORE_INCLUDE_STAGED_RELEASES=0
# Optional Google Play Developer API credentials for exact Android versionCode.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_CLIENT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY=

# Optional: broad club logos via API-Football (free key: https://dashboard.api-football.com).
# Used by `npm run ingest:apilogos`. The logo image CDN itself is keyless.
API_FOOTBALL_KEY=
API_FOOTBALL_SEASON=2023

# ElevenLabs Sound Effects generation. Keep the real key only in local/private env.
ELEVENLABS_API_KEY=

# ---- Transfermarkt API (primary data source) ----
# Local instance of felipeall/transfermarkt-api
#   docker run -p 8000:8000 felipeall/transfermarkt-api
TM_API=http://127.0.0.1:8000
TM_DELAY_MS=700
TM_CONCURRENCY=5
TM_SEASON_FROM=2006
TM_SEASON_TO=2025
# TM_COMPETITIONS=TR1,GB1    # override to limit scope for quick test
# TM_PHASE=A                 # run only one phase: A | B | C
