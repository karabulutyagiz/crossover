{
  "name": "@crossover/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Crossover game server — data layer, Transfermarkt ingest, player verification",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "renormalize": "tsx src/db/renormalize.ts",
    "ingest": "tsx src/ingest/tm-rebuild.ts",
    "ingest:swap": "tsx src/ingest/tm-swap.ts",
    "ingest:marketvalue": "tsx src/ingest/tm-marketvalue.ts",
    "ingest:wikidata": "tsx src/ingest/run.ts",
    "ingest:logos": "tsx src/ingest/logos.ts",
    "ingest:apilogos": "tsx src/ingest/apifootball-logos.ts",
    "ingest:photos": "tsx src/ingest/photos.ts",
    "ingest:photos:wiki": "tsx src/ingest/photos-wiki.ts",
    "ingest:logos:broad": "tsx src/ingest/logos-broad.ts",
    "ingest:transfers": "tsx src/ingest/transfers-apifootball.ts",
    "ingest:transfers:tr": "tsx src/ingest/transfers-turkey.ts",
    "ingest:sportmonks": "tsx src/ingest/sportmonks.ts",
    "ingest:nationalities": "tsx src/ingest/nationalities.ts",
    "export:offline": "tsx src/cli/export-offline.ts",
    "rebuild": "tsx src/ingest/tm-rebuild.ts && tsx src/ingest/tm-swap.ts && tsx src/ingest/tm-marketvalue.ts && tsx src/cli/export-offline.ts",
    "verify": "tsx src/cli/verify.ts",
    "playtest": "tsx src/cli/playtest.ts",
    "bot": "tsx src/cli/bot.ts",
    "test:difficulty": "tsx src/cli/difftest-invariants.ts",
    "test:hybrid-matchmaking": "tsx src/cli/hybridmatchtest.ts",
    "test:opponent-system": "tsx src/cli/opponent-invariants.ts",
    "sim:opponent": "tsx src/cli/opponent-sim.ts",
    "report:bot-difficulty": "tsx src/cli/bot-difficulty-report.ts",
    "check:protocol": "tsx src/cli/check-protocol-drift.ts",
    "probe:difficulty": "tsx src/cli/difftest.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "check:production": "node src/cli/production-check.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "dotenv": "^16.4.5",
    "pg": "^8.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.10",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0"
  }
}
