{
  "name": "@crossover/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Crossover game server — data layer, Wikidata ingest, player verification (Phase 2)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "renormalize": "tsx src/db/renormalize.ts",
    "ingest": "tsx src/ingest/run.ts",
    "ingest:logos": "tsx src/ingest/logos.ts",
    "ingest:apilogos": "tsx src/ingest/apifootball-logos.ts",
    "ingest:photos": "tsx src/ingest/photos.ts",
    "ingest:photos:wiki": "tsx src/ingest/photos-wiki.ts",
    "ingest:logos:broad": "tsx src/ingest/logos-broad.ts",
    "ingest:transfers": "tsx src/ingest/transfers-apifootball.ts",
    "ingest:transfers:tr": "tsx src/ingest/transfers-turkey.ts",
    "ingest:sportmonks": "tsx src/ingest/sportmonks.ts",
    "ingest:nationalities": "tsx src/ingest/nationalities.ts",
    "verify": "tsx src/cli/verify.ts",
    "playtest": "tsx src/cli/playtest.ts",
    "bot": "tsx src/cli/bot.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.10",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0"
  }
}
