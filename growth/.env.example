# Crossover Growth OS — örnek env. Gerçek sırlar ASLA repoya girmez.

# Oyunla aynı Postgres (growth_* tabloları + clubs/players salt-okunur).
DATABASE_URL=postgres://localhost:5432/crossover_dev

GROWTH_PORT=8090

# Boş bırakılırsa growth API TAMAMEN kapalı (jeton imza anahtarı).
GROWTH_ADMIN_TOKEN=

# Tracking linkleri bu origin'den döner: <TRACKING_BASE_URL>/r/<code>
TRACKING_BASE_URL=https://growth.crossoverfootball.com
WEBSITE_URL=https://crossoverfootball.com
IOS_STORE_URL=https://apps.apple.com/tr/app/id6778542426
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.crossover.football

# ── X (Twitter) — resmi API v2, OAuth 1.0a user context (COF hesabı) ──
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── Telegram — resmi Bot API, yalnızca owned kanallar ──
TELEGRAM_BOT_TOKEN=
# Virgülle ayrılmış: @crossoverfootball,-1001234567890
TELEGRAM_OWNED_CHANNELS=

# ── Instagram — Graph API (Business/Creator hesap + long-lived token) ──
IG_USER_ID=
IG_ACCESS_TOKEN=

# Opsiyonel LLM cilası (boşsa şablon motoru tek başına çalışır).
ANTHROPIC_API_KEY=

# Owned hesaplarda insan onayı olmadan yayın (varsayılan KAPALI — bilinçli aç).
GROWTH_AUTO_PUBLISH_OWNED=0

# Global emniyet tavanları (provider limitlerinin üstüne çıkılamaz).
GROWTH_GLOBAL_MAX_POSTS_PER_DAY=20
GROWTH_GLOBAL_MIN_INTERVAL_MINUTES=20

# Günlük plan hedefleri (platform başına aday içerik).
GROWTH_PLAN_X_PER_DAY=4
GROWTH_PLAN_IG_PER_DAY=2
GROWTH_PLAN_TG_PER_DAY=2

# İçerik yorgunluğu penceresi + benzerlik eşiği.
GROWTH_FATIGUE_WINDOW_DAYS=30
GROWTH_SIMILARITY_THRESHOLD=0.85

# Öğrenme: exploit oranı (kalanı keşif — bölüm 24, 80/20).
GROWTH_EXPLOIT_RATIO=0.8
