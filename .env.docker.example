# Crossover Docker stack — copy to `.env` next to docker-compose.yml and fill in.
#   cp .env.docker.example .env

# Public hostname (transyol's Caddy gets the TLS cert for it). New server IP in
# nip.io form: 168.222.180.190 -> 168-222-180-190.nip.io
DOMAIN=168-222-180-190.nip.io

# Postgres (internal only; never exposed to the host). Use a strong password.
POSTGRES_USER=crossover
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_DB=crossover

# App secrets — fill from the old server's server/.env (do NOT commit real values).
IAP_SHARED_SECRET=
APPLE_BUNDLE_ID=com.crossover.football
# GOOGLE_CLIENT_IDS=
# FACEBOOK_APP_ID=
# Optional server-side/dev sound generation only. Never bundle this in the mobile app.
ELEVENLABS_API_KEY=

VERIFY_MATCH_THRESHOLD=0.3
VERIFY_EXACT_THRESHOLD=0.85
MAINTENANCE_MODE=0
MIN_IOS_BUILD=1
MIN_ANDROID_VERSION_CODE=1

# Store-driven forced updates. Server compares each client with the live store
# version/build and returns updateRequired automatically.
STORE_VERSION_CHECK_ENABLED=1
STORE_VERSION_CHECK_CACHE_MS=600000
STORE_VERSION_CHECK_TIMEOUT_MS=4000
STORE_VERSION_CHECK_STALE_IF_ERROR_MS=86400000
IOS_APP_STORE_ID=6778542426
IOS_BUNDLE_ID=com.crossover.football
APP_STORE_COUNTRY=tr
# App Store Connect API key. Put the .p8 contents as base64 or with escaped \n.
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_PRIVATE_KEY=
ANDROID_PACKAGE_NAME=com.crossover.football
PLAY_STORE_COUNTRY=TR
PLAY_STORE_LANGUAGE=en
PLAY_STORE_INCLUDE_STAGED_RELEASES=0
# Optional Google Play Developer API credentials for exact Android versionCode.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_CLIENT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY=
DB_POOL_MAX=30
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Hybrid matchmaking rollout (server-side safety net). Keep ON in production so
# players never remain stuck without an opponent when human liquidity is low.
HYBRID_MATCHMAKING_ENABLED=1
BOT_FALLBACK_ENABLED=1
BOT_FALLBACK_PERCENTAGE=100
BOT_FALLBACK_MIN_DELAY_MS=1800
BOT_FALLBACK_MAX_DELAY_MS=3800
# Optional tuning knobs; safe defaults match the code.
# REAL_PLAYER_SEARCH_WINDOW_MS=1200
# EXPANDED_SEARCH_WINDOW_MS=2500
# INITIAL_TROPHY_RANGE=100
# EXPANDED_TROPHY_RANGE=450
# MATCHMAKING_TIMEOUT_MS=15000
# HUMAN_LIQUIDITY_HOLD_MS=6500
# BOT_FALLBACK_RETRY_MS=700
