+  maximumDbWaiting = Math.max(maximumDbWaiting, snapshot.databasePool.waiting);
+  maximumFootballDbWaiting = Math.max(maximumFootballDbWaiting, snapshot.footballDatabasePool?.waiting ?? 0);
