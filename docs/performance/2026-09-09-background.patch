+      if (message.type === 'error') errors.push(message.message);
+      const i = this.waiters.findIndex(waiter => waiter.matches(message));
+      if (i >= 0) this.waiters.splice(i, 1)[0].resolve(message);
+      else this.messages.push(message);
+    });
